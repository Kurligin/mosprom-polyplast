# Скопировать в .env и заполнить
MAX_BOT_TOKEN=
MAX_BOT_NAME=
MAX_API_BASE_URL=https://platform-api2.max.ru
MINIAPP_URL=
GIGACHAT_CLIENT_ID=
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
DATABASE_URL=postgresql+asyncpg://korsik:korsik@postgres:5432/korsik
PUBLIC_BASE_URL=
TZ_DEFAULT=Europe/Moscow
CA_BUNDLE_FILE=certs/russian_trusted_ca_bundle.pem
BOT_ENABLED=true
JOBS_ENABLED=true
# Только для разработки: Mini App в браузере без initData
DEV_ALLOW_NO_INIT_DATA=false
# LLM: gigachat (облако) или openai — локальная модель в закрытом контуре через OpenAI-совместимый API
LLM_PROVIDER=gigachat
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
