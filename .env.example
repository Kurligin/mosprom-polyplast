# Скопировать в .env и заполнить
MAX_BOT_TOKEN=
MAX_BOT_NAME=
MAX_API_BASE_URL=https://platform-api2.max.ru
MINIAPP_URL=
DATABASE_URL=postgresql+asyncpg://korsik:korsik@postgres:5432/korsik
PUBLIC_BASE_URL=
TZ_DEFAULT=Europe/Moscow
CA_BUNDLE_FILE=certs/russian_trusted_ca_bundle.pem
BOT_ENABLED=true
JOBS_ENABLED=true
# Только для разработки: Mini App в браузере без initData
DEV_ALLOW_NO_INIT_DATA=false
# Модель: открытая модель в закрытом контуре компании через OpenAI-совместимый API (Ollama, vLLM)
LLM_PROVIDER=openai
# Ollama: http://ollama:11434/v1, vLLM: http://vllm:8000/v1
LLM_BASE_URL=http://ollama:11434/v1
# Имя модели на сервере модели
LLM_MODEL=
# Ключ, если сервер модели его требует
LLM_API_KEY=
# Необязательно: провайдер gigachat (LLM_PROVIDER=gigachat), только если выбран он
# GIGACHAT_CLIENT_ID=
# GIGACHAT_CREDENTIALS=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat-2
# Закрытый контур: модель эмбеддингов только с диска (том models), без обращений к HuggingFace
# HF_HUB_OFFLINE=1
# EMBEDDING_MODEL=/models/bge-m3
